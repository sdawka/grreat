---
import Container from '../layout/Container.astro';
import Prose from '../primitives/Prose.astro';

// Editorial masthead/hero with category line, headline, and email signup CTA
export interface Props {
  class?: string;
}

const { class: className, ...rest } = Astro.props;
---

<Container as="section" size="content" aria-label="Introduction" class:list={['hero', className]} {...rest}>
  <span class="edition">The working edition</span>
  <h1 class="wordmark">
    GRREAT<span class="reg">™</span>
  </h1>
  <p class="tagline">
    Goals · Research · Roadmap · Execution · Analysis · Time.<br />
    A cyclical feedback operating system for building the life you want.
  </p>
  <Prose class="lede" measure={false}>
    You know the life you want. It gets built one project at a time — and projects die in the gap between wanting and doing. GRREAT is the engine that closes it: you and your AI agent, always one clear next action, learning from every cycle.
  </Prose>

  <div class="hero-action">
    <div class="kicker">
      <span class="kicker-chip">Early access</span>
      <span>Join the waitlist</span>
    </div>
    <Prose class="lede-compact" size="body-s" measure={false}>
      Get launch notes, early product access, and real examples of builders and their AI agents turning intentions into finished work.
    </Prose>
    <slot name="form" />
  </div>
</Container>

<style>
  /* Container's own scoped base rule compiles to `.container[data-astro-cid-*]`
     (specificity 0,2,0) — a bare `:global(.hero)` (0,1,0) loses to it outright.
     Pairing both classes present on the rendered element ties specificity;
     source order (this file compiles after its Container import) decides. */
  :global(.container.hero) {
    padding-inline: var(--gutter);
    padding-block: var(--space-11) var(--space-10);
  }

  .edition {
    display: block;
    font-family: var(--mono);
    font-size: var(--text-1);
    text-transform: uppercase;
    letter-spacing: var(--tracking-caps-2);
    color: var(--text-muted);
    margin-block-end: var(--space-2);
  }
  .wordmark {
    /* Legacy used the `font:` shorthand, which implicitly resets font-weight
       to normal — the actual bug behind the unresolved "glyph outline" diff
       reported earlier. Longhand properties don't reset it, so the <h1>'s
       UA-default bold survives unless stated explicitly (same footgun
       Section's `.number`/`.title` already guard against). */
    font-weight: 400;
    font-family: var(--serif);
    font-size: var(--text-d3);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-display);
  }

  .wordmark .reg {
    /* Inherits 400 from .wordmark above now, but legacy's own `font:`
       shorthand reset this independently too — stated explicitly to match. */
    font-weight: 400;
    font-family: var(--mono);
    font-size: var(--text-1); /* legacy 8px at every width; floored, accepted deviation */
    vertical-align: top;
    margin-inline-start: var(--space-1);
    letter-spacing: 0;
  }

  .tagline {
    font-family: var(--sans);
    font-size: var(--text-tagline);
    line-height: var(--leading-snug);
    color: var(--text-muted);
    margin-block-start: var(--space-5);
    max-inline-size: var(--measure);
  }

  :global(.prose.lede) {
    margin-block-start: var(--space-4);
    max-inline-size: var(--measure);
  }

  .hero-action {
    margin-block-start: var(--space-10);
    border-block-start: var(--border-1) solid var(--border-strong);
    padding-block-start: var(--space-7);
  }

  .kicker {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-block-end: var(--space-4);
    font-family: var(--mono);
    font-size: var(--text-1);
    text-transform: uppercase;
    letter-spacing: var(--tracking-caps-2);
  }

  .kicker-chip {
    background: var(--surface-inverse);
    color: var(--text-on-inverse);
    padding: var(--space-1) var(--space-2);
  }

  :global(.prose.lede-compact) {
    margin-block-end: var(--space-4);
    line-height: var(--leading-normal);
    max-inline-size: var(--content-form);
  }
</style>
